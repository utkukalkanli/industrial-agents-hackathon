# Copy to .env (git-ignored) and fill in. Never commit .env; never paste keys into chat or code.
ANTHROPIC_API_KEY=
# LLM provider (agent/llm_client.py, D-024): openai | anthropic. Unset → anthropic only when ANTHROPIC_API_KEY is the only key, else openai.
LLM_PROVIDER=
OPENAI_API_KEY=
# Optional OpenAI models for the Claude ids the agents use (agent/openai_llm.py):
# OPENAI_MODEL=gpt-6.1-sol  (opus: Guide, Builder, Creator, solver agent)
# OPENAI_MID_MODEL=gpt-6.1-terra  (sonnet: LLM parser)
# OPENAI_SMALL_MODEL=gpt-6-luna  (haiku: voice transcript rewriter)
ELEVENLABS_API_KEY=
# Optional: the Guide's voice (backend/tts.py). Defaults: voice "River" SAz9YHcvj6GT2YYXdXww, model eleven_flash_v2_5.
TTS_VOICE_ID=
TTS_MODEL=
# Optional: the user's words go to ElevenLabs Scribe Realtime (backend/stt.py); "browser" keeps browser recognition.
STT_MODE=scribe
# Optional: question parser (see agent/parsing.py)
PARSER_MODE=hybrid
# Supabase (docs/research/stack-options.md#6-env-vars--secrets). Project Settings → API Keys / Connect.
SUPABASE_URL=
# Publishable (anon) key: public, safe for the frontend.
SUPABASE_ANON_KEY=
# Secret (service_role) key: backend only, never in the frontend.
SUPABASE_SERVICE_ROLE_KEY=
# Connect → Transaction pooler URI (port 6543), with your DB password filled in (URL-encode special characters).
SUPABASE_DB_URL=
# Access mode (demo feature, off by default; docs/superpowers/specs/2026-10-25-access-profiles-design.md):
# on = sign-in, restricted spaces, remembered preferences, moving objects. Never used by the benchmark.
ACCESS_MODE=off
# Admin accounts (Supabase Auth emails, comma-separated): rights over every building.
ADMIN_EMAIL=
